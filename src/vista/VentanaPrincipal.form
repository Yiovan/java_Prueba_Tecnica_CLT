<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="vista.VentanaPrincipal">
  <grid id="27dc6" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="5" left="5" bottom="5" right="5"/>
    <constraints>
      <xy x="20" y="20" width="740" height="490"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <!-- 1. ZONA FORMULARIO (Arriba) -->
      <grid id="formPanel" layout-manager="GridLayoutManager" row-count="6" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="5" vgap="5">
        <margin top="5" left="5" bottom="5" right="5"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="etched" title="Datos del Producto"/>
        <children>
          <component id="labelCodigo" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Código"/>
            </properties>
          </component>
          <component id="txtCodigoField" class="javax.swing.JTextField" binding="txtCodigo">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
            </constraints>
            <properties/>
          </component>
          <component id="labelNombre" class="javax.swing.JLabel">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Nombre"/>
            </properties>
          </component>
          <component id="txtNombreField" class="javax.swing.JTextField" binding="txtNombre">
            <constraints>
              <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
            </constraints>
            <properties/>
          </component>
          <component id="labelCategoria" class="javax.swing.JLabel">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Categoría"/>
            </properties>
          </component>
          <component id="txtCategoriaField" class="javax.swing.JTextField" binding="txtCategoria">
            <constraints>
              <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
            </constraints>
            <properties/>
          </component>
          <component id="labelPrecio" class="javax.swing.JLabel">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Precio"/>
            </properties>
          </component>
          <component id="txtPrecioField" class="javax.swing.JTextField" binding="txtPrecio">
            <constraints>
              <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
            </constraints>
            <properties/>
          </component>
          <component id="labelStock" class="javax.swing.JLabel">
            <constraints>
              <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Stock"/>
            </properties>
          </component>
          <component id="txtStockField" class="javax.swing.JTextField" binding="txtStock">
            <constraints>
              <grid row="4" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
            </constraints>
            <properties/>
          </component>
          <component id="labelEstado" class="javax.swing.JLabel">
            <constraints>
              <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Estado"/>
            </properties>
          </component>
          <component id="cboEstadoField" class="javax.swing.JComboBox" binding="cboEstado">
            <constraints>
              <grid row="5" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <model>
                <item value="Activo"/>
                <item value="Inactivo"/>
              </model>
            </properties>
          </component>
        </children>
      </grid>
      <!-- 2. ZONA ACCIONES Y BÚSQUEDA (Centro) -->
      <grid id="accionesPanel" layout-manager="GridLayoutManager" row-count="1" column-count="7" same-size-horizontally="false" same-size-vertically="false" hgap="5" vgap="5">
        <margin top="5" left="5" bottom="5" right="5"/>
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="etched" title="Acciones"/>
        <children>
          <component id="btnNuevoComp" class="javax.swing.JButton" binding="btnNuevo">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Nuevo"/>
            </properties>
          </component>
          <component id="btnGuardarComp" class="javax.swing.JButton" binding="btnGuardar">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Guardar"/>
            </properties>
          </component>
          <component id="btnModificarComp" class="javax.swing.JButton" binding="btnModificar">
            <constraints>
              <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Modificar"/>
            </properties>
          </component>
          <component id="btnEliminarComp" class="javax.swing.JButton" binding="btnEliminar">
            <constraints>
              <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Eliminar"/>
            </properties>
          </component>
          <component id="btnBuscarComp" class="javax.swing.JButton" binding="btnBuscar">
            <constraints>
              <grid row="0" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Buscar"/>
            </properties>
          </component>
          <component id="txtBuscarField" class="javax.swing.JTextField" binding="txtBuscar">
            <constraints>
              <grid row="0" column="5" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
            </constraints>
            <properties/>
          </component>
          <component id="btnBajoStockComp" class="javax.swing.JButton" binding="btnBajoStock">
            <constraints>
              <grid row="0" column="6" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Bajo Stock"/>
            </properties>
          </component>
        </children>
      </grid>
      <!-- 3. ZONA LISTADO (Abajo) -->
      <component id="scrollPaneComp" class="javax.swing.JScrollPane" binding="scrollPane">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="etched" title="Listado de Productos"/>
        <children>
          <component id="tablaProductosComp" class="javax.swing.JTable" binding="tablaProductos">
            <constraints>
              <xy x="20" y="20" width="500" height="400"/>
            </constraints>
            <properties>
              <model>
                <column title="Código"/>
                <column title="Nombre"/>
                <column title="Categoría"/>
                <column title="Precio"/>
                <column title="Stock"/>
                <column title="Estado"/>
              </model>
            </properties>
          </component>
        </children>
      </component>
    </children>
  </grid>
</form>
